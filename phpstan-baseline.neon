parameters:
	ignoreErrors:
		-
			message: '#^Trait Maize\\LegalConsent\\HasLegalConsent is used zero times and is not analysed\.$#'
			identifier: trait.unused
			count: 1
			path: src/HasLegalConsent.php

		-
			message: '#^Call to an undefined method Illuminate\\Foundation\\Auth\\User\:\:acceptLegalDocument\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Http/Controllers/LegalConsentController.php
